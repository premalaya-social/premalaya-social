<!-- Navigation -->
<nav class="bg-white sticky top-0 z-50 border-b border-gray-200/60" style="box-shadow:0 1px 2px rgba(0,0,0,0.04);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 lg:h-[70px]">
            <a href="/" class="flex-shrink-0" aria-label="Home">
                <div class="navlogo"></div>
            </a>

            <!-- Desktop -->
            <div class="hidden lg:flex items-center gap-1">
                {% for item in navigation.main %}
                {% if item.children %}
                <div class="relative group/nav">
                    <button class="px-3 py-2 text-[14px] font-medium text-gray-600 hover:text-primary-500 rounded-lg hover:bg-gray-50 transition-all flex items-center gap-1">
                        {{ item.label }}
                        <svg class="w-3.5 h-3.5 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </button>
                    <div class="absolute left-0 top-full pt-2 w-56 opacity-0 invisible group-hover/nav:opacity-100 group-hover/nav:visible transition-all duration-150">
                        <div class="bg-white rounded-lg py-1 border border-gray-200/80" style="box-shadow:0 4px 24px rgba(0,0,0,0.08);">
                            {% for child in item.children %}
                            <a href="{{ child.url }}" class="block px-4 py-2 text-[13px] text-gray-500 hover:text-primary-500 hover:bg-gray-50 transition-colors">{{ child.label }}</a>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                {% elif item.url == '/' %}
                <a href="{{ item.url }}" class="px-3 py-2 text-[14px] font-medium rounded-lg transition-all {% if page.url == item.url %}text-primary-500 bg-primary-50/60{% else %}text-gray-600 hover:text-primary-500 hover:bg-gray-50{% endif %}">{{ item.label }}</a>
                {% elif item.highlight %}
                <a href="{{ item.url }}" class="ml-2 px-5 py-2 text-[14px] font-semibold text-white bg-primary-500 rounded-lg hover:bg-primary-600 transition-colors">{{ item.label }}</a>
                {% else %}
                <a href="{{ item.url }}" class="px-3 py-2 text-[14px] font-medium rounded-lg transition-all {% if page.url == item.url %}text-primary-500 bg-primary-50/60{% else %}text-gray-600 hover:text-primary-500 hover:bg-gray-50{% endif %}">{{ item.label }}</a>
                {% endif %}
                {% endfor %}
            </div>

            <!-- Mobile -->
            <div class="flex items-center gap-1 lg:hidden">
                <a href="tel:{{ site.phone }}" class="md:hidden w-9 h-9 flex items-center justify-center rounded-lg text-gray-400 hover:text-primary-500 hover:bg-gray-50" aria-label="Call">
                    <i class="fa-solid fa-phone text-sm"></i>
                </a>
                <button id="mobile-menu-btn" class="w-9 h-9 flex items-center justify-center rounded-lg text-gray-500 hover:text-primary-500 hover:bg-gray-50 transition-colors">
                    <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/></svg>
                    <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white">
        <div class="px-4 py-2 max-h-[80vh] overflow-y-auto">
            {% for item in navigation.main %}
            {% if item.children %}
            <div>
                <button class="mobile-dropdown-btn w-full flex items-center justify-between px-3 py-3 text-[15px] font-medium text-gray-600 hover:text-primary-500 transition-colors">
                    {{ item.label }}
                    <svg class="dropdown-icon w-4 h-4 opacity-30 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div class="hidden pb-2 pl-3 border-l border-gray-100 ml-3">
                    {% for child in item.children %}
                    <a href="{{ child.url }}" class="block px-3 py-2 text-[14px] text-gray-400 hover:text-primary-500 transition-colors">{{ child.label }}</a>
                    {% endfor %}
                </div>
            </div>
            {% elif item.highlight %}
            <div class="py-2 mt-1">
                <a href="{{ item.url }}" class="block text-center px-4 py-2.5 text-[15px] font-semibold text-white bg-primary-500 rounded-lg hover:bg-primary-600 transition-colors">{{ item.label }}</a>
            </div>
            {% else %}
            <a href="{{ item.url }}" class="block px-3 py-3 text-[15px] font-medium text-gray-600 hover:text-primary-500 transition-colors">{{ item.label }}</a>
            {% endif %}
            {% endfor %}
        </div>
    </div>
</nav>
