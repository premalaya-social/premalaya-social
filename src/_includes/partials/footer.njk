<!-- Footer — FA-style dark footer with trust badges -->
<footer class="bg-slate-900 text-slate-400">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 py-14 lg:py-16">
            <!-- About Column -->
            <div class="sm:col-span-2 lg:col-span-1">
                <div class="flex items-center gap-2.5 mb-5">
                    <div class="navlogo brightness-0 invert opacity-80" style="width:36px;height:36px;"></div>
                    <div class="flex flex-col leading-none">
                        <span class="font-heading text-white font-black text-xs uppercase tracking-tight">Premalaya</span>
                        <span class="font-heading text-slate-500 font-medium text-[7px] uppercase tracking-[0.08em]">Social Development Society</span>
                    </div>
                </div>
                <p class="text-sm leading-relaxed text-slate-400/90 mb-5">
                    Working for the well-being of downtrodden and vulnerable sections through education, health, advocacy and social mobilization since 1994.
                </p>
                <div class="flex gap-2.5 mb-6">
                    <a href="{{ site.facebook }}" target="_blank" rel="noopener" class="w-9 h-9 rounded-full bg-slate-800 border border-slate-700/50 flex items-center justify-center text-slate-400 hover:bg-primary-500 hover:border-primary-500 hover:text-white transition-all duration-200">
                        <i class="fa-brands fa-facebook-f text-sm"></i>
                    </a>
                </div>
                <!-- Trust badges — like FA's Charity Navigator + BBB -->
                <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-slate-800">
                    <div class="flex items-center gap-2 bg-slate-800/50 rounded-lg px-3 py-2">
                        <i class="fa-solid fa-building-columns text-primary-400 text-xs"></i>
                        <span class="text-[11px] text-slate-300 font-medium">Registered</span>
                    </div>
                    <div class="flex items-center gap-2 bg-slate-800/50 rounded-lg px-3 py-2">
                        <i class="fa-solid fa-receipt text-primary-400 text-xs"></i>
                        <span class="text-[11px] text-slate-300 font-medium">80G Exempt</span>
                    </div>
                    <div class="flex items-center gap-2 bg-slate-800/50 rounded-lg px-3 py-2">
                        <i class="fa-solid fa-globe text-primary-400 text-xs"></i>
                        <span class="text-[11px] text-slate-300 font-medium">FCRA</span>
                    </div>
                </div>
            </div>

            <!-- Quick Links -->
            <div>
                <h4 class="font-heading text-white font-semibold text-sm tracking-wide mb-5">About Us</h4>
                <ul class="space-y-3">
                    <li><a href="/about/" class="text-sm text-slate-400 hover:text-white transition-colors duration-200">About</a></li>
                    <li><a href="/vision-mission/" class="text-sm text-slate-400 hover:text-white transition-colors duration-200">Vision & Mission</a></li>
                    <li><a href="/founder/" class="text-sm text-slate-400 hover:text-white transition-colors duration-200">Our Founder</a></li>
                    <li><a href="/governing-committee/" class="text-sm text-slate-400 hover:text-white transition-colors duration-200">Governing Committee</a></li>
                    <li><a href="/donors-list/" class="text-sm text-slate-400 hover:text-white transition-colors duration-200">Donors</a></li>
                </ul>
            </div>

            <!-- Programs -->
            <div>
                <h4 class="font-heading text-white font-semibold text-sm tracking-wide mb-5">Programs</h4>
                <ul class="space-y-3">
                    <li><a href="/women-empowerment/" class="text-sm text-slate-400 hover:text-white transition-colors duration-200">Women Empowerment</a></li>
                    <li><a href="/children-home/" class="text-sm text-slate-400 hover:text-white transition-colors duration-200">Children's Home</a></li>
                    <li><a href="/health-care/" class="text-sm text-slate-400 hover:text-white transition-colors duration-200">Health Care</a></li>
                    <li><a href="/medical-camps/" class="text-sm text-slate-400 hover:text-white transition-colors duration-200">Medical Camps</a></li>
                    <li><a href="/relief-operations/" class="text-sm text-slate-400 hover:text-white transition-colors duration-200">Relief Operations</a></li>
                    <li><a href="/educational-activities/" class="text-sm text-slate-400 hover:text-white transition-colors duration-200">Education</a></li>
                    <li><a href="/shankar-narayan-library/" class="text-sm text-slate-400 hover:text-white transition-colors duration-200">Library</a></li>
                    <li><a href="/savitribai-scholarships/" class="text-sm text-slate-400 hover:text-white transition-colors duration-200">Scholarships</a></li>
                </ul>
            </div>

            <!-- Contact + Ways to Give -->
            <div>
                <h4 class="font-heading text-white font-semibold text-sm tracking-wide mb-5">Contact Us</h4>
                <ul class="space-y-4 mb-8">
                    <li class="flex items-start gap-3">
                        <i class="fa-solid fa-location-dot text-xs text-primary-400 mt-1 w-4 text-center flex-shrink-0"></i>
                        <span class="text-sm leading-relaxed">{{ site.address }}</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <i class="fa-solid fa-phone text-xs text-primary-400 w-4 text-center flex-shrink-0"></i>
                        <a href="tel:{{ site.phone }}" class="text-sm hover:text-white transition-colors">{{ site.phone }}</a>
                    </li>
                    <li class="flex items-center gap-3">
                        <i class="fa-solid fa-envelope text-xs text-primary-400 w-4 text-center flex-shrink-0"></i>
                        <a href="mailto:{{ site.contactEmail }}" class="text-sm hover:text-white transition-colors">{{ site.contactEmail }}</a>
                    </li>
                </ul>
                <h4 class="font-heading text-white font-semibold text-sm tracking-wide mb-4">Ways to Give</h4>
                <ul class="space-y-3">
                    <li><a href="/support/" class="text-sm text-slate-400 hover:text-white transition-colors duration-200">Support Us</a></li>
                    <li><a href="/contact/" class="text-sm text-slate-400 hover:text-white transition-colors duration-200">Contact Us</a></li>
                </ul>
            </div>
        </div>

        <!-- Bottom Bar -->
        <div class="border-t border-slate-800/80 py-6 flex flex-col sm:flex-row justify-between items-center gap-3">
            <p class="text-xs text-slate-500">{{ site.copyright }}</p>
            {% if site.poweredBy and site.poweredBy != "--" %}
            <p class="text-xs text-slate-500"><a href="{{ site.poweredByUrl }}" class="hover:text-slate-300 transition-colors">{{ site.poweredBy }}</a></p>
            {% endif %}
        </div>
    </div>
</footer>
