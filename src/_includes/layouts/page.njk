---
layout: layouts/base.njk
---

<!-- Page Banner -->
{% if bannerImage %}
{% set mobileMap = { "short": "160px", "medium": "240px", "tall": "280px", "xtall": "320px", "hd": "400px", "xxtall": "480px" } %}
{% set desktopMap = { "short": "220px", "medium": "320px", "tall": "420px", "xtall": "520px", "hd": "720px", "xxtall": "1080px" } %}
{% set bKey = bannerHeight or "medium" %}
{% set focusClass = { "center": "object-center", "top": "object-top", "bottom": "object-bottom" } %}
{% set focusStyle = { "center-top": "center 25%", "center-bottom": "center 75%" } %}
{% set bfVal = bannerFocus or "center" %}
<style>
    .page-banner { height: {{ mobileMap[bKey] or "240px" }}; }
    @media(min-width:640px) { .page-banner { height: clamp({{ mobileMap[bKey] or "240px" }}, 45vw, {{ desktopMap[bKey] or "320px" }}); } }
    @media(min-width:1024px) { .page-banner { height: {{ desktopMap[bKey] or "320px" }}; } }
</style>
<div class="page-banner relative w-full overflow-hidden">
    <img src="{{ bannerImage }}" alt="{{ title }}" class="w-full h-full object-cover {{ focusClass[bfVal] or '' }} scale-[1.01]" {% if focusStyle[bfVal] %}style="object-position:{{ focusStyle[bfVal] }}"{% endif %}>
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
</div>

<div class="relative -mt-16 sm:-mt-20 z-10">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10">
        <div class="bg-white rounded-t-3xl shadow-xl px-8 sm:px-10 lg:px-12 pt-8 sm:pt-10 pb-6 sm:pb-8 border-t-4 border-accent-500">
            <nav class="flex items-center gap-2 text-xs text-slate-400 mb-3">
                <a href="/" class="hover:text-primary-500 transition-colors">Home</a>
                <svg class="w-3 h-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                <span class="text-slate-600 font-medium">{{ title }}</span>
            </nav>
            <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 leading-tight">
                {{ title }}
            </h1>
            {% if lead %}
            <p class="mt-3 text-base sm:text-lg text-slate-500 leading-relaxed max-w-2xl">{{ lead }}</p>
            {% endif %}
        </div>
    </div>
</div>
{% else %}
<!-- No-banner header -->
<div class="bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10 py-12 md:py-16">
        <nav class="flex items-center gap-2 text-xs text-slate-400 mb-4">
            <a href="/" class="hover:text-primary-500 transition-colors">Home</a>
            <svg class="w-3 h-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            <span class="text-slate-600 font-medium">{{ title }}</span>
        </nav>
        <div class="flex items-center gap-4 mb-1">
            <div class="w-10 h-1 bg-accent-500 rounded-full"></div>
        </div>
        <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 leading-tight">{{ title }}</h1>
        {% if lead %}
        <p class="mt-3 text-base sm:text-lg text-slate-500 max-w-2xl leading-relaxed">{{ lead }}</p>
        {% endif %}
    </div>
</div>
{% endif %}

<!-- Main Content -->
<div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10 py-14 md:py-20">
    <div class="flex flex-col lg:flex-row gap-10 lg:gap-14">
        <!-- Content Column -->
        <div class="{% if sidebar %}lg:w-2/3{% else %}w-full max-w-4xl{% endif %}">
            <div class="content-area">
                {{ content | safe }}
            </div>

            {% if gallery and gallery | length %}
            <!-- Photo Gallery -->
            <div class="mt-16">
                <p class="font-heading text-xs font-bold tracking-[0.2em] uppercase text-primary-500 mb-2">Gallery</p>
                <h2 class="font-heading text-2xl md:text-3xl font-black text-slate-900 mb-8">Photo Gallery</h2>
                {% set ratioMap = { "square": "aspect-square", "4/3": "aspect-[4/3]", "3/2": "aspect-[3/2]", "16/9": "aspect-video", "3/4": "aspect-[3/4]", "auto": "" } %}
                {% set galRatio = ratioMap[galleryRatio] if galleryRatio else "aspect-square" %}
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 sm:gap-4">
                    {% for image in gallery %}
                    <button type="button" class="gallery-thumb group relative {{ galRatio }} rounded-2xl overflow-hidden border border-slate-100 hover:shadow-lg transition-all duration-300 cursor-pointer text-left" data-gallery-index="{{ loop.index0 }}">
                        <img src="{{ image.src }}" alt="{{ image.alt or title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
                        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/25 transition-colors duration-300 flex items-center justify-center">
                            <i class="fa-solid fa-expand text-white text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 drop-shadow-lg"></i>
                        </div>
                    </button>
                    {% endfor %}
                </div>
                {% if gallery | length %}
                <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 sm:gap-4">
                    {% for image in gallery %}
                    {% if image.caption %}
                    <p class="text-xs text-slate-400 text-center px-1 truncate">{{ image.caption }}</p>
                    {% else %}
                    <p></p>
                    {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
            </div>

            <script type="application/json" id="gallery-data">
            [{% for image in gallery %}{"src":"{{ image.src }}","alt":"{{ image.alt or title }}","caption":"{{ image.caption or '' }}"}{% if not loop.last %},{% endif %}{% endfor %}]
            </script>
            {% endif %}
        </div>

        {% if sidebar %}
        <!-- Sidebar -->
        <aside class="lg:w-1/3">
            <div class="lg:sticky lg:top-24 space-y-6">
                {% if sidebarInfo %}
                <div class="rounded-2xl border border-slate-100 overflow-hidden shadow-sm">
                    <div class="bg-primary-600 px-6 py-5">
                        <h3 class="font-heading text-white font-bold text-base">
                            <i class="fa-solid fa-circle-info mr-2 opacity-70"></i>{{ sidebarInfo.title or "Information" }}
                        </h3>
                    </div>
                    <div class="bg-white p-5 space-y-3.5">
                        {% for item in sidebarInfo.items %}
                        <div class="flex items-start gap-3">
                            <div class="w-1.5 h-1.5 rounded-full bg-accent-500 mt-2 flex-shrink-0"></div>
                            <div>
                                <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">{{ item.label }}</p>
                                <p class="text-sm text-slate-700 font-medium mt-0.5">{{ item.value }}</p>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                <div class="bg-white rounded-2xl border border-slate-100 p-6 shadow-sm">
                    <h3 class="font-heading font-bold text-slate-900 text-lg mb-2">{{ sidebarCta.title or "Support This Program" }}</h3>
                    <p class="text-sm text-slate-500 mb-5 leading-relaxed">{{ sidebarCta.text or "Your support can make a significant difference in the lives of those we serve." }}</p>
                    <div class="space-y-2.5">
                        <a href="/support/" class="flex items-center justify-center px-5 py-3 bg-accent-500 text-white rounded-xl font-bold text-sm hover:bg-accent-600 transition-colors shadow-sm shadow-accent-500/20">
                            <i class="fa-solid fa-hand-holding-heart mr-2 text-xs"></i>
                            {{ sidebarCta.primaryButton or "Support Us" }}
                        </a>
                        <a href="/contact/" class="flex items-center justify-center px-5 py-3 border border-slate-200 text-slate-700 rounded-xl font-semibold text-sm hover:bg-slate-50 transition-colors">
                            <i class="fa-solid fa-envelope mr-2 text-xs opacity-50"></i>
                            {{ sidebarCta.secondaryButton or "Contact Us" }}
                        </a>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-slate-100 p-6 shadow-sm">
                    <h3 class="font-heading font-bold text-slate-900 mb-4">Explore More</h3>
                    <ul class="space-y-1">
                        <li><a href="/about/" class="flex items-center gap-2.5 text-sm text-slate-500 hover:text-primary-500 transition-colors py-2 px-2 rounded-lg hover:bg-slate-50"><svg class="w-3 h-3 text-slate-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>About Us</a></li>
                        <li><a href="/vision-mission/" class="flex items-center gap-2.5 text-sm text-slate-500 hover:text-primary-500 transition-colors py-2 px-2 rounded-lg hover:bg-slate-50"><svg class="w-3 h-3 text-slate-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>Vision & Mission</a></li>
                        <li><a href="/savitribai-scholarships/" class="flex items-center gap-2.5 text-sm text-slate-500 hover:text-primary-500 transition-colors py-2 px-2 rounded-lg hover:bg-slate-50"><svg class="w-3 h-3 text-slate-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>Scholarships</a></li>
                        <li><a href="/support/" class="flex items-center gap-2.5 text-sm text-slate-500 hover:text-primary-500 transition-colors py-2 px-2 rounded-lg hover:bg-slate-50"><svg class="w-3 h-3 text-slate-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>Support Us</a></li>
                    </ul>
                </div>
            </div>
        </aside>
        {% endif %}
    </div>

    {% if mapEmbed %}
    <div class="mt-16">
        <p class="font-heading text-xs font-bold tracking-[0.2em] uppercase text-primary-500 mb-2">Location</p>
        <h2 class="font-heading text-2xl md:text-3xl font-black text-slate-900 mb-6">Find Us</h2>
        <div class="rounded-2xl overflow-hidden shadow-lg">
            <iframe src="{{ mapEmbed }}" width="100%" height="450" frameborder="0" style="border:0" allowfullscreen loading="lazy"></iframe>
        </div>
    </div>
    {% endif %}
</div>

<!-- CTA Banner — matches home "Join Us" bar -->
<section class="py-14 md:py-16 bg-primary-600">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
            <div>
                <h2 class="font-heading text-2xl md:text-3xl font-black text-white text-center md:text-left">Want to Make a Difference?</h2>
                <p class="text-primary-200 text-sm mt-2 text-center md:text-left max-w-lg">Your support can transform lives. Join us in creating positive change.</p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <a href="/support/" class="inline-flex items-center px-7 py-3.5 bg-accent-500 text-white rounded-full font-bold text-sm hover:bg-accent-600 transition-colors shadow-lg shadow-accent-500/30">
                    <i class="fa-solid fa-hand-holding-heart mr-2"></i> Support Us
                </a>
                <a href="/contact/" class="inline-flex items-center px-7 py-3.5 bg-white/15 border border-white/20 text-white rounded-full font-semibold text-sm hover:bg-white/25 transition-all">
                    <i class="fa-solid fa-envelope mr-2 opacity-70"></i> Contact Us
                </a>
            </div>
        </div>
    </div>
</section>
