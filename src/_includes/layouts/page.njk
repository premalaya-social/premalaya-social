---
layout: layouts/base.njk
---

<!-- Page Banner -->
{% if bannerImage %}
{% set mobileMap = { "short": "160px", "medium": "220px", "tall": "260px", "xtall": "300px", "hd": "360px", "xxtall": "420px" } %}
{% set desktopMap = { "short": "200px", "medium": "300px", "tall": "400px", "xtall": "500px", "hd": "720px", "xxtall": "1080px" } %}
{% set bKey = bannerHeight or "medium" %}
{% set focusClass = { "center": "object-center", "top": "object-top", "bottom": "object-bottom" } %}
{% set focusStyle = { "center-top": "center 25%", "center-bottom": "center 75%" } %}
{% set bfVal = bannerFocus or "center" %}
<style>
    .page-banner { height: {{ mobileMap[bKey] or "220px" }}; }
    @media(min-width:640px) { .page-banner { height: clamp({{ mobileMap[bKey] or "220px" }}, 45vw, {{ desktopMap[bKey] or "300px" }}); } }
    @media(min-width:1024px) { .page-banner { height: {{ desktopMap[bKey] or "300px" }}; } }
</style>
<div class="page-banner relative w-full overflow-hidden">
    <img src="{{ bannerImage }}" alt="{{ title }}" class="w-full h-full object-cover {{ focusClass[bfVal] or '' }} scale-[1.02]" {% if focusStyle[bfVal] %}style="object-position:{{ focusStyle[bfVal] }}"{% endif %}>
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-primary-900/40 to-transparent"></div>
    <div class="absolute inset-0 flex items-end">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pb-8 sm:pb-10 md:pb-12">
            <div class="max-w-2xl">
                <div class="w-12 h-1 bg-secondary-400 rounded-full mb-4"></div>
                <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-white font-roboto leading-tight tracking-tight">
                    <span class="inline-decoration" style="text-shadow: 0 2px 20px rgba(0,0,0,0.5);">{{ title }}</span>
                </h1>
                {% if lead %}
                <p class="mt-3 sm:mt-4 text-sm sm:text-base md:text-lg text-white/85 leading-relaxed max-w-xl" style="text-shadow: 0 1px 8px rgba(0,0,0,0.4);">{{ lead }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endif %}

<!-- Breadcrumbs -->
<div class="bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <nav class="flex items-center gap-2 text-sm text-gray-500">
            <a href="/" class="hover:text-primary-500 transition-colors">
                <i class="fa-solid fa-house text-xs"></i>
                <span class="ml-1">Home</span>
            </a>
            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            <span class="text-gray-800 font-medium">{{ title }}</span>
        </nav>
    </div>
</div>

<!-- Main Content -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
    {% if not bannerImage %}
    <div class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 font-roboto">{{ title }}</h1>
        {% if lead %}
        <p class="mt-3 text-lg text-gray-500 max-w-3xl">{{ lead }}</p>
        {% endif %}
        <div class="mt-4 w-20 h-1 bg-primary-500 rounded-full"></div>
    </div>
    {% endif %}

    <div class="flex flex-col lg:flex-row gap-10">
        <!-- Content Column -->
        <div class="{% if sidebar %}lg:w-2/3{% else %}w-full max-w-4xl{% endif %}">
            <div class="content-area bg-white rounded-2xl border border-gray-200 p-6 sm:p-8 md:p-10 shadow-sm">
                {{ content | safe }}
            </div>

            {% if gallery and gallery | length %}
            <!-- Photo Gallery -->
            <div class="mt-10">
                <h2 class="text-2xl font-bold text-gray-900 font-roboto mb-6">
                    <i class="fa-solid fa-images text-primary-500 mr-2"></i>Gallery
                </h2>
                {% set ratioMap = { "square": "aspect-square", "4/3": "aspect-[4/3]", "3/2": "aspect-[3/2]", "16/9": "aspect-video", "3/4": "aspect-[3/4]", "auto": "" } %}
                {% set galRatio = ratioMap[galleryRatio] if galleryRatio else "aspect-square" %}
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                    {% for image in gallery %}
                    <button type="button" class="gallery-thumb group relative {{ galRatio }} rounded-xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-lg transition-all duration-300 cursor-pointer text-left" data-gallery-index="{{ loop.index0 }}">
                        <img src="{{ image.src }}" alt="{{ image.alt or title }}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy">
                        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-300 flex items-center justify-center">
                            <i class="fa-solid fa-expand text-white text-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 drop-shadow-lg"></i>
                        </div>
                        {% if image.caption %}
                        <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent px-3 py-2 translate-y-full group-hover:translate-y-0 transition-transform duration-300">
                            <p class="text-white text-xs leading-snug truncate">{{ image.caption }}</p>
                        </div>
                        {% endif %}
                    </button>
                    {% endfor %}
                </div>
            </div>

            <!-- Lightbox data for JS -->
            <script type="application/json" id="gallery-data">
            [{% for image in gallery %}{"src":"{{ image.src }}","alt":"{{ image.alt or title }}","caption":"{{ image.caption or '' }}"}{% if not loop.last %},{% endif %}{% endfor %}]
            </script>
            {% endif %}
        </div>

        {% if sidebar %}
        <!-- Sidebar -->
        <aside class="lg:w-1/3">
            <div class="lg:sticky lg:top-24 space-y-6">
                {% if sidebarInfo %}
                <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm">
                    <div class="bg-gradient-to-r from-primary-500 to-accent px-6 py-4">
                        <h3 class="text-white font-bold text-lg font-roboto">
                            <i class="fa-solid fa-circle-info mr-2"></i>{{ sidebarInfo.title or "Information" }}
                        </h3>
                    </div>
                    <div class="p-6 space-y-4">
                        {% for item in sidebarInfo.items %}
                        <div class="flex items-start gap-3">
                            <div class="w-2 h-2 rounded-full bg-primary-500 mt-2 flex-shrink-0"></div>
                            <div>
                                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">{{ item.label }}</p>
                                <p class="text-sm text-gray-700 font-medium mt-0.5">{{ item.value }}</p>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                <div class="bg-gradient-to-br from-primary-500 via-primary-600 to-accent rounded-2xl p-6 text-white shadow-lg">
                    <h3 class="text-lg font-bold font-roboto mb-2">{{ sidebarCta.title or "Support This Program" }}</h3>
                    <p class="text-sm text-primary-100 mb-5 leading-relaxed">{{ sidebarCta.text or "Your support can make a significant difference in the lives of those we serve." }}</p>
                    <div class="space-y-3">
                        <a href="/support/" class="flex items-center justify-center px-5 py-2.5 bg-white text-primary-600 rounded-lg font-semibold text-sm hover:bg-gray-100 transition-all shadow">
                            <i class="fa-solid fa-hand-holding-heart mr-2"></i>
                            {{ sidebarCta.primaryButton or "Support Us" }}
                        </a>
                        <a href="/contact/" class="flex items-center justify-center px-5 py-2.5 border-2 border-white/40 text-white rounded-lg font-semibold text-sm hover:bg-white/10 transition-all">
                            <i class="fa-solid fa-envelope mr-2"></i>
                            {{ sidebarCta.secondaryButton or "Contact Us" }}
                        </a>
                    </div>
                </div>

                <!-- Quick Navigation -->
                <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
                    <h3 class="font-bold text-gray-900 font-roboto mb-4">
                        <i class="fa-solid fa-compass text-secondary-500 mr-2"></i>Explore More
                    </h3>
                    <ul class="space-y-2">
                        <li><a href="/about/" class="flex items-center gap-2 text-sm text-gray-600 hover:text-primary-500 transition-colors py-1"><i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>About Us</a></li>
                        <li><a href="/vision-mission/" class="flex items-center gap-2 text-sm text-gray-600 hover:text-primary-500 transition-colors py-1"><i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>Vision & Mission</a></li>
                        <li><a href="/savitribai-scholarships/" class="flex items-center gap-2 text-sm text-gray-600 hover:text-primary-500 transition-colors py-1"><i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>Scholarships</a></li>
                        <li><a href="/support/" class="flex items-center gap-2 text-sm text-gray-600 hover:text-primary-500 transition-colors py-1"><i class="fa-solid fa-chevron-right text-xs text-gray-400"></i>Support Us</a></li>
                    </ul>
                </div>
            </div>
        </aside>
        {% endif %}
    </div>

    {% if mapEmbed %}
    <!-- Google Map -->
    <div class="mt-14">
        <h2 class="text-2xl font-bold text-gray-900 font-roboto mb-6">
            <i class="fa-solid fa-map-location-dot text-primary-500 mr-2"></i>Find Us
        </h2>
        <div class="rounded-2xl overflow-hidden shadow-lg border border-gray-200">
            <iframe src="{{ mapEmbed }}" width="100%" height="400" frameborder="0" style="border:0" allowfullscreen loading="lazy"></iframe>
        </div>
    </div>
    {% endif %}
</div>

<!-- CTA Banner -->
<section class="bg-gradient-to-r from-primary-500 to-accent py-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-xl md:text-2xl font-bold text-white mb-3 font-roboto">Want to Make a Difference?</h2>
        <p class="text-primary-100 mb-5 text-sm sm:text-base">Your support can transform lives. Join us in creating positive change in communities.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/support/" class="inline-flex items-center justify-center px-6 py-2.5 bg-white text-primary-600 rounded-lg font-semibold text-sm hover:bg-gray-100 transition-all shadow">
                <i class="fa-solid fa-hand-holding-heart mr-2"></i> Support Us
            </a>
            <a href="/contact/" class="inline-flex items-center justify-center px-6 py-2.5 border-2 border-white/40 text-white rounded-lg font-semibold text-sm hover:bg-white/10 transition-all">
                <i class="fa-solid fa-envelope mr-2"></i> Contact Us
            </a>
        </div>
    </div>
</section>
