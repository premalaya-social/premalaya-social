---
layout: layouts/base.njk
---

<!-- Page Banner -->
{% if bannerImage %}
{% set mobileMap = { "short": "160px", "medium": "220px", "tall": "260px", "xtall": "300px", "hd": "360px", "xxtall": "420px" } %}
{% set desktopMap = { "short": "200px", "medium": "300px", "tall": "400px", "xtall": "500px", "hd": "720px", "xxtall": "1080px" } %}
{% set bKey = bannerHeight or "medium" %}
{% set focusClass = { "center": "object-center", "top": "object-top", "bottom": "object-bottom" } %}
{% set focusStyle = { "center-top": "center 25%", "center-bottom": "center 75%" } %}
{% set bfVal = bannerFocus or "center" %}
<style>
    .page-banner { height: {{ mobileMap[bKey] or "220px" }}; }
    @media(min-width:640px) { .page-banner { height: clamp({{ mobileMap[bKey] or "220px" }}, 45vw, {{ desktopMap[bKey] or "300px" }}); } }
    @media(min-width:1024px) { .page-banner { height: {{ desktopMap[bKey] or "300px" }}; } }
</style>
<div class="page-banner relative w-full overflow-hidden">
    <img src="{{ bannerImage }}" alt="{{ title }}" class="w-full h-full object-cover {{ focusClass[bfVal] or '' }} scale-[1.01]" {% if focusStyle[bfVal] %}style="object-position:{{ focusStyle[bfVal] }}"{% endif %}>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 via-slate-900/25 to-transparent"></div>
    <div class="absolute inset-0 flex items-end">
        <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 w-full pb-8 sm:pb-10">
            <div class="max-w-2xl">
                <nav class="flex items-center gap-2 text-xs text-white/60 mb-3">
                    <a href="/" class="hover:text-white transition-colors">Home</a>
                    <svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    <span class="text-white/90">{{ title }}</span>
                </nav>
                <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-extrabold text-white leading-tight" style="text-shadow:0 2px 16px rgba(0,0,0,.3);">
                    {{ title }}
                </h1>
                {% if lead %}
                <p class="mt-3 text-sm sm:text-base text-white/80 leading-relaxed max-w-xl" style="text-shadow:0 1px 6px rgba(0,0,0,.3);">{{ lead }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% else %}
<!-- No-banner header -->
<div class="bg-slate-50 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 py-3">
        <nav class="flex items-center gap-2 text-sm text-slate-400">
            <a href="/" class="hover:text-primary-500 transition-colors">
                <i class="fa-solid fa-house text-xs"></i>
                <span class="ml-1">Home</span>
            </a>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            <span class="text-slate-700 font-medium">{{ title }}</span>
        </nav>
    </div>
</div>
{% endif %}

<!-- Main Content -->
<div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10 py-12 md:py-16">
    {% if not bannerImage %}
    <div class="mb-10">
        <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900">{{ title }}</h1>
        {% if lead %}
        <p class="mt-3 text-lg text-slate-400 max-w-3xl">{{ lead }}</p>
        {% endif %}
        <div class="mt-5 w-16 h-1 bg-primary-500 rounded-full"></div>
    </div>
    {% endif %}

    <div class="flex flex-col lg:flex-row gap-10 lg:gap-12">
        <!-- Content Column -->
        <div class="{% if sidebar %}lg:w-2/3{% else %}w-full max-w-3xl{% endif %}">
            <div class="content-area bg-white rounded-2xl border border-slate-100 p-6 sm:p-8 md:p-10 shadow-sm">
                {{ content | safe }}
            </div>

            {% if gallery and gallery | length %}
            <!-- Photo Gallery -->
            <div class="mt-12">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-8 h-8 rounded-lg bg-primary-50 flex items-center justify-center">
                        <i class="fa-solid fa-images text-primary-500 text-sm"></i>
                    </div>
                    <h2 class="text-xl font-bold text-slate-800">Photo Gallery</h2>
                </div>
                {% set ratioMap = { "square": "aspect-square", "4/3": "aspect-[4/3]", "3/2": "aspect-[3/2]", "16/9": "aspect-video", "3/4": "aspect-[3/4]", "auto": "" } %}
                {% set galRatio = ratioMap[galleryRatio] if galleryRatio else "aspect-square" %}
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 sm:gap-4">
                    {% for image in gallery %}
                    <button type="button" class="gallery-thumb group relative {{ galRatio }} rounded-xl overflow-hidden border border-slate-100 hover:shadow-lg transition-all duration-300 cursor-pointer text-left" data-gallery-index="{{ loop.index0 }}">
                        <img src="{{ image.src }}" alt="{{ image.alt or title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
                        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/25 transition-colors duration-300 flex items-center justify-center">
                            <i class="fa-solid fa-expand text-white text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 drop-shadow-lg"></i>
                        </div>
                    </button>
                    {% endfor %}
                </div>
                {% if gallery | length %}
                <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 sm:gap-4">
                    {% for image in gallery %}
                    {% if image.caption %}
                    <p class="text-xs text-slate-400 text-center px-1 truncate">{{ image.caption }}</p>
                    {% else %}
                    <p></p>
                    {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
            </div>

            <script type="application/json" id="gallery-data">
            [{% for image in gallery %}{"src":"{{ image.src }}","alt":"{{ image.alt or title }}","caption":"{{ image.caption or '' }}"}{% if not loop.last %},{% endif %}{% endfor %}]
            </script>
            {% endif %}
        </div>

        {% if sidebar %}
        <!-- Sidebar -->
        <aside class="lg:w-1/3">
            <div class="lg:sticky lg:top-20 space-y-6">
                {% if sidebarInfo %}
                <div class="bg-white rounded-2xl border border-slate-100 overflow-hidden shadow-sm">
                    <div class="bg-primary-500 px-6 py-4">
                        <h3 class="text-white font-bold text-base">
                            <i class="fa-solid fa-circle-info mr-2 opacity-70"></i>{{ sidebarInfo.title or "Information" }}
                        </h3>
                    </div>
                    <div class="p-5 space-y-3.5">
                        {% for item in sidebarInfo.items %}
                        <div class="flex items-start gap-3">
                            <div class="w-1.5 h-1.5 rounded-full bg-primary-400 mt-2 flex-shrink-0"></div>
                            <div>
                                <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">{{ item.label }}</p>
                                <p class="text-sm text-slate-700 font-medium mt-0.5">{{ item.value }}</p>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                <div class="bg-white rounded-2xl border border-slate-100 p-6 shadow-sm">
                    <h3 class="font-bold text-slate-800 mb-2">{{ sidebarCta.title or "Support This Program" }}</h3>
                    <p class="text-sm text-slate-400 mb-5 leading-relaxed">{{ sidebarCta.text or "Your support can make a significant difference in the lives of those we serve." }}</p>
                    <div class="space-y-2.5">
                        <a href="/support/" class="flex items-center justify-center px-5 py-2.5 bg-accent-500 text-white rounded-xl font-bold text-sm hover:bg-accent-600 transition-colors shadow-sm shadow-accent-500/20">
                            <i class="fa-solid fa-hand-holding-heart mr-2 text-xs"></i>
                            {{ sidebarCta.primaryButton or "Support Us" }}
                        </a>
                        <a href="/contact/" class="flex items-center justify-center px-5 py-2.5 border border-slate-200 text-slate-600 rounded-xl font-semibold text-sm hover:bg-slate-50 transition-colors">
                            <i class="fa-solid fa-envelope mr-2 text-xs opacity-60"></i>
                            {{ sidebarCta.secondaryButton or "Contact Us" }}
                        </a>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-slate-100 p-6 shadow-sm">
                    <h3 class="font-bold text-slate-800 mb-4">
                        <i class="fa-solid fa-compass text-primary-400 mr-2 text-sm"></i>Explore More
                    </h3>
                    <ul class="space-y-1">
                        <li><a href="/about/" class="flex items-center gap-2.5 text-sm text-slate-500 hover:text-primary-500 transition-colors py-2 px-2 rounded-lg hover:bg-slate-50"><i class="fa-solid fa-chevron-right text-[10px] text-slate-300"></i>About Us</a></li>
                        <li><a href="/vision-mission/" class="flex items-center gap-2.5 text-sm text-slate-500 hover:text-primary-500 transition-colors py-2 px-2 rounded-lg hover:bg-slate-50"><i class="fa-solid fa-chevron-right text-[10px] text-slate-300"></i>Vision & Mission</a></li>
                        <li><a href="/savitribai-scholarships/" class="flex items-center gap-2.5 text-sm text-slate-500 hover:text-primary-500 transition-colors py-2 px-2 rounded-lg hover:bg-slate-50"><i class="fa-solid fa-chevron-right text-[10px] text-slate-300"></i>Scholarships</a></li>
                        <li><a href="/support/" class="flex items-center gap-2.5 text-sm text-slate-500 hover:text-primary-500 transition-colors py-2 px-2 rounded-lg hover:bg-slate-50"><i class="fa-solid fa-chevron-right text-[10px] text-slate-300"></i>Support Us</a></li>
                    </ul>
                </div>
            </div>
        </aside>
        {% endif %}
    </div>

    {% if mapEmbed %}
    <!-- Google Map -->
    <div class="mt-14">
        <div class="flex items-center gap-3 mb-6">
            <div class="w-8 h-8 rounded-lg bg-primary-50 flex items-center justify-center">
                <i class="fa-solid fa-map-location-dot text-primary-500 text-sm"></i>
            </div>
            <h2 class="text-xl font-bold text-slate-800">Find Us</h2>
        </div>
        <div class="rounded-2xl overflow-hidden border border-slate-100 shadow-sm">
            <iframe src="{{ mapEmbed }}" width="100%" height="400" frameborder="0" style="border:0" allowfullscreen loading="lazy"></iframe>
        </div>
    </div>
    {% endif %}
</div>

<!-- CTA Banner -->
<section class="py-16 md:py-20 bg-primary-600">
    <div class="max-w-3xl mx-auto px-6 sm:px-8 text-center">
        <h2 class="font-heading text-2xl md:text-3xl font-extrabold text-white mb-4">Want to Make a Difference?</h2>
        <p class="text-primary-200 mb-8 text-base max-w-xl mx-auto leading-relaxed">Your support can transform lives. Join us in creating positive change in communities across India.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/support/" class="inline-flex items-center justify-center px-8 py-3.5 bg-accent-500 text-white rounded-full font-bold text-base hover:bg-accent-600 transition-colors shadow-lg shadow-accent-500/30">
                <i class="fa-solid fa-hand-holding-heart mr-2"></i> Support Us
            </a>
            <a href="/contact/" class="inline-flex items-center justify-center px-8 py-3.5 bg-white/15 border border-white/20 text-white rounded-full font-semibold text-base hover:bg-white/25 transition-all">
                <i class="fa-solid fa-envelope mr-2 opacity-70"></i> Contact Us
            </a>
        </div>
    </div>
</section>
