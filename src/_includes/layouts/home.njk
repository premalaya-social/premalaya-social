<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link href="/favicon.ico" type="image/x-icon" rel="icon">
    <link href="/favicon.ico" type="image/x-icon" rel="shortcut icon">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href='https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap' rel='stylesheet'>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/swiper/swiper.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: { 50:'#f0f1ff', 100:'#e0e2ff', 200:'#c7caff', 300:'#a3a7ff', 400:'#7b7fff', 500:'#2f3192', 600:'#262a7a', 700:'#1d2062', 800:'#14174a', 900:'#0b0d32' },
                        secondary: { 50:'#edfaff', 100:'#d6f3ff', 200:'#b5ecff', 300:'#83e0ff', 400:'#3eb8e6', 500:'#1090bf', 600:'#0d7299' },
                        warm: { 50:'#fffbeb', 100:'#fef3c7', 400:'#fbbf24', 500:'#f59e0b' }
                    },
                    fontFamily: { 'sans':['Inter','system-ui','-apple-system','sans-serif'] }
                }
            }
        }
    </script>
    <style>
        .navlogo { background-image:url('/img/images2/premalayalogos.png'); background-size:contain; background-repeat:no-repeat; background-position:center left; width:180px; height:44px; }
        @media(min-width:768px) { .navlogo { background-image:url('/img/images2/premalayalogol.png'); width:280px; height:48px; } }

        /* Ken Burns zoom on carousel images */
        @keyframes kenBurns { 0% { transform:scale(1); } 100% { transform:scale(1.06); } }
        .swiper-slide-active .hero-img,
        .swiper-slide-duplicate-active .hero-img { animation:kenBurns 32s ease-out forwards; }

        /* Carousel nav arrows -- always visible, solid dark circles */
        .hero-carousel .swiper-button-next,
        .hero-carousel .swiper-button-prev {
            width:36px!important; height:36px!important;
            background:rgba(15,15,15,0.5)!important;
            border-radius:50%!important; border:none!important;
            transition:background .2s ease, transform .2s ease!important;
        }
        .hero-carousel .swiper-button-next:after,
        .hero-carousel .swiper-button-prev:after { font-size:12px!important; color:#fff!important; font-weight:700!important; }
        .hero-carousel .swiper-button-next:hover,
        .hero-carousel .swiper-button-prev:hover { background:rgba(15,15,15,0.7)!important; transform:scale(1.1)!important; }
        .hero-carousel .swiper-button-next { right:10px!important; }
        .hero-carousel .swiper-button-prev { left:10px!important; }
        @media(max-width:639px) {
            .hero-carousel .swiper-button-next,
            .hero-carousel .swiper-button-prev { width:32px!important; height:32px!important; }
            .hero-carousel .swiper-button-next:after,
            .hero-carousel .swiper-button-prev:after { font-size:10px!important; }
            .hero-carousel .swiper-button-next { right:8px!important; }
            .hero-carousel .swiper-button-prev { left:8px!important; }
        }

        /* Carousel pagination */
        .hero-dots { position:absolute; bottom:12px; left:0; right:0; text-align:center; z-index:20; }
        .hero-dots .swiper-pagination-bullet { width:6px!important; height:6px!important; border-radius:50%!important; background:#fff!important; opacity:.4!important; transition:all .3s!important; margin:0 3px!important; }
        .hero-dots .swiper-pagination-bullet-active { opacity:1!important; width:20px!important; border-radius:3px!important; }

        /* Carousel progress bar */
        .hero-progress { position:absolute; bottom:0; left:0; height:2px; background:rgba(255,255,255,0.7); z-index:25; width:0; border-radius:0 1px 1px 0; }

        /* Slide badge animation */
        .hero-carousel .swiper-slide-active .hero-badge,
        .hero-carousel .swiper-slide-duplicate-active .hero-badge { animation:fadeIn .5s .2s ease forwards; }
        .hero-badge { opacity:0; }
        @keyframes fadeIn { to { opacity:1; } }

        @keyframes countUp { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
        .stat-animate { animation: countUp 0.6s ease-out forwards; }

        /* Scroll reveal */
        [data-reveal] { opacity:0; transform:translateY(20px); transition:opacity 0.7s ease, transform 0.7s ease; }
        [data-reveal].revealed { opacity:1; transform:translateY(0); }
        [data-reveal-delay="1"] { transition-delay:0.1s; }
        [data-reveal-delay="2"] { transition-delay:0.2s; }
        [data-reveal-delay="3"] { transition-delay:0.3s; }
        @media(prefers-reduced-motion:reduce) { [data-reveal] { opacity:1; transform:none; transition:none; } }
    </style>
</head>
<body class="font-sans antialiased text-slate-700 bg-white">

    {% include "partials/nav.njk" %}

    <!-- ═══════════ SECTION 1: Hero (Split Layout) ═══════════ -->
    <section class="bg-white">
        <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
            <div class="flex flex-col lg:flex-row lg:items-center lg:gap-12 xl:gap-16 py-8 sm:py-10 lg:py-16">

                <!-- LEFT: Text Content (appears below carousel on mobile) -->
                <div class="order-2 lg:order-1 lg:w-[45%] xl:w-[42%] flex-shrink-0 mt-8 lg:mt-0" data-reveal>
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-primary-50 rounded-full text-primary-500 text-xs font-semibold tracking-wide uppercase mb-5">
                        <span class="w-1.5 h-1.5 bg-primary-500 rounded-full"></span>
                        Welcome to Premalaya
                    </div>

                    <h1 class="text-2xl sm:text-3xl lg:text-[2.25rem] xl:text-[2.5rem] font-extrabold text-slate-900 leading-[1.15] tracking-tight">
                        Compassion in Action,<br>
                        <span class="text-primary-500">Hope for Communities</span>
                    </h1>

                    <p class="mt-4 lg:mt-5 text-slate-500 text-sm sm:text-[15px] leading-relaxed max-w-lg">
                        {{ site.description | truncate(200) }}
                    </p>

                    <!-- CTAs -->
                    <div class="flex flex-wrap gap-3 mt-7 lg:mt-8">
                        <a href="/about/" class="inline-flex items-center px-6 py-3 bg-primary-500 text-white rounded-full text-sm font-semibold hover:bg-primary-600 transition-colors shadow-sm shadow-primary-500/20">
                            Learn More
                            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                        </a>
                        <a href="/support/" class="inline-flex items-center px-6 py-3 border border-slate-200 text-slate-600 rounded-full text-sm font-semibold hover:border-slate-300 hover:bg-slate-50 transition-all">
                            <i class="fa-solid fa-hand-holding-heart mr-2 text-xs text-primary-400"></i>
                            Support Us
                        </a>
                    </div>

                    <!-- Quick trust badges -->
                    <div class="mt-8 lg:mt-10 pt-6 lg:pt-8 border-t border-slate-100">
                        <div class="flex flex-wrap gap-x-5 gap-y-3">
                            {% if trustPoints and trustPoints | length %}
                                {% for point in trustPoints %}
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-full bg-primary-50 flex items-center justify-center flex-shrink-0">
                                        <i class="{{ point.icon or 'fa-solid fa-check' }} text-primary-500 text-[10px]"></i>
                                    </div>
                                    <span class="text-xs font-medium text-slate-500">{{ point.label }}</span>
                                </div>
                                {% endfor %}
                            {% else %}
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-full bg-primary-50 flex items-center justify-center"><i class="fa-solid fa-building-columns text-primary-500 text-[10px]"></i></div>
                                    <span class="text-xs font-medium text-slate-500">Registered Society</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-full bg-primary-50 flex items-center justify-center"><i class="fa-solid fa-receipt text-primary-500 text-[10px]"></i></div>
                                    <span class="text-xs font-medium text-slate-500">80G Tax Exempt</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-full bg-primary-50 flex items-center justify-center"><i class="fa-solid fa-globe text-primary-500 text-[10px]"></i></div>
                                    <span class="text-xs font-medium text-slate-500">FCRA Certified</span>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- RIGHT: Image Carousel -->
                <div class="order-1 lg:order-2 lg:w-[55%] xl:w-[58%]" data-reveal data-reveal-delay="1">
                    <div class="hero-carousel relative rounded-2xl lg:rounded-3xl overflow-hidden shadow-2xl shadow-slate-900/10" style="aspect-ratio:16/10;">
                        <div class="swiper-container gallery-top w-full h-full">
                            <div class="swiper-wrapper">
                                {% for slide in heroSlides %}
                                <div class="swiper-slide relative overflow-hidden">
                                    <a href="{{ slide.link }}" class="block w-full h-full" aria-label="{{ slide.heading }}">
                                        {% set slideFocusMap = { "center":"object-center", "top":"object-top", "bottom":"object-bottom", "left":"object-left", "right":"object-right" } %}
                                        <img src="{{ slide.image }}" alt="{{ slide.alt }}" class="hero-img w-full h-full object-cover {{ slideFocusMap[slide.imageFocus] or 'object-center' }}" loading="{% if loop.index0 == 0 %}eager{% else %}lazy{% endif %}">
                                        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>

                                        <!-- Overlay badge + title on image -->
                                        <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-5 z-10">
                                            {% if slide.badge %}
                                            <span class="hero-badge inline-flex items-center gap-1.5 px-3 py-1 bg-white/15 backdrop-blur-md border border-white/10 rounded-full text-white text-[11px] font-medium tracking-wide uppercase mb-2">
                                                <span class="w-1 h-1 bg-white rounded-full"></span>
                                                {{ slide.badge }}
                                            </span>
                                            {% endif %}
                                            <h2 class="text-white font-bold text-base sm:text-lg md:text-xl leading-snug" style="text-shadow:0 1px 8px rgba(0,0,0,.3);">{{ slide.heading }}</h2>
                                            {% if slide.subtext %}
                                            <p class="text-white/65 text-xs sm:text-sm mt-1 hidden sm:block max-w-sm leading-relaxed">{{ slide.subtext }}</p>
                                            {% endif %}
                                        </div>
                                    </a>
                                </div>
                                {% endfor %}
                            </div>

                            <div class="swiper-button-next"></div>
                            <div class="swiper-button-prev"></div>
                            <div class="hero-dots swiper-pagination"></div>
                            <div id="hero-progress" class="hero-progress"></div>
                        </div>
                    </div>

                    <!-- Slide counter below carousel -->
                    <div class="flex items-center justify-between mt-3 px-1">
                        <div class="flex items-center gap-2 text-slate-400 text-xs font-medium" style="font-variant-numeric:tabular-nums;">
                            <span id="hero-current" class="text-slate-700 text-sm font-bold">01</span>
                            <span class="w-4 h-px bg-slate-200"></span>
                            <span class="text-sm">0{{ heroSlides | length }}</span>
                        </div>
                        <a href="/pdf/savithribaischolarship.pdf" class="inline-flex items-center text-xs text-slate-400 hover:text-primary-500 transition-colors gap-1.5">
                            <i class="fa-solid fa-download text-[10px]"></i>
                            Scholarship Form
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ═══════════ SECTION 3: Impact Stats ═══════════ -->
    <section class="py-12 md:py-14 bg-slate-50 border-y border-slate-100">
        <div class="max-w-5xl mx-auto px-5 sm:px-8" data-reveal>
            {% if impactStats and impactStats | length %}
            <div class="grid grid-cols-2 md:grid-cols-{{ impactStats | length }} gap-6 md:gap-8">
                {% for stat in impactStats %}
                <div class="text-center stat-animate" style="animation-delay:{{ loop.index0 * 0.15 }}s;">
                    <div class="text-3xl sm:text-4xl md:text-[2.75rem] font-extrabold text-primary-500 leading-none mb-2">{{ stat.number }}</div>
                    <p class="text-sm text-slate-500 font-medium">{{ stat.label }}</p>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8">
                <div class="text-center">
                    <div class="w-12 h-12 rounded-xl bg-primary-50 flex items-center justify-center mx-auto mb-3">
                        <i class="fa-solid fa-users text-primary-500 text-lg"></i>
                    </div>
                    <h3 class="text-sm font-bold text-slate-800">Community Focus</h3>
                    <p class="text-xs text-slate-400 mt-1 max-w-[200px] mx-auto">Serving vulnerable sections across Tamil Nadu & Andhra Pradesh</p>
                </div>
                <div class="text-center">
                    <div class="w-12 h-12 rounded-xl bg-secondary-50 flex items-center justify-center mx-auto mb-3">
                        <i class="fa-solid fa-book-open text-secondary-500 text-lg"></i>
                    </div>
                    <h3 class="text-sm font-bold text-slate-800">Education First</h3>
                    <p class="text-xs text-slate-400 mt-1 max-w-[200px] mx-auto">Scholarships and skill development programs</p>
                </div>
                <div class="text-center">
                    <div class="w-12 h-12 rounded-xl bg-green-50 flex items-center justify-center mx-auto mb-3">
                        <i class="fa-solid fa-heart-pulse text-green-500 text-lg"></i>
                    </div>
                    <h3 class="text-sm font-bold text-slate-800">Healthcare Access</h3>
                    <p class="text-xs text-slate-400 mt-1 max-w-[200px] mx-auto">Medical camps serving underserved communities</p>
                </div>
            </div>
            {% endif %}
        </div>
    </section>

    <!-- ═══════════ SECTION 4: Programs Grid ═══════════ -->
    <section class="py-16 md:py-20 bg-white">
        <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
            <div class="text-center mb-12" data-reveal>
                <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-primary-50 rounded-full text-primary-500 text-xs font-semibold tracking-wide uppercase mb-4">
                    <span class="w-1.5 h-1.5 bg-primary-500 rounded-full"></span>
                    What We Do
                </div>
                <h2 class="text-2xl md:text-3xl font-bold text-slate-900">How We Serve</h2>
                <p class="mt-3 text-slate-400 max-w-xl mx-auto text-sm sm:text-base">Transforming lives through dedicated programs in education, health, and community development.</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-7">
                {% for card in projectCards %}
                {% set projFocusMap = { "center":"object-center", "top":"object-top", "bottom":"object-bottom" } %}
                <a href="{{ card.link }}" class="group bg-white rounded-2xl overflow-hidden border border-slate-100 hover:border-slate-200 hover:shadow-lg hover:shadow-slate-100 transition-all duration-300" data-reveal data-reveal-delay="{{ (loop.index0 % 3) + 1 }}">
                    <div class="aspect-[16/10] overflow-hidden">
                        <img src="{{ card.image }}" alt="{{ card.alt }}" class="w-full h-full object-cover {{ projFocusMap[card.imageFocus] or 'object-center' }} group-hover:scale-105 transition-transform duration-500" loading="lazy">
                    </div>
                    <div class="p-5 sm:p-6">
                        <h3 class="font-semibold text-slate-800 mb-1.5 group-hover:text-primary-500 transition-colors">{{ card.title }}</h3>
                        <p class="text-slate-400 text-sm leading-relaxed line-clamp-2">{{ card.description }}</p>
                        <span class="inline-flex items-center gap-1.5 text-primary-500 text-sm font-medium mt-4 group-hover:gap-2.5 transition-all">
                            Learn more
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                        </span>
                    </div>
                </a>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- ═══════════ SECTION 5: About / Who We Are ═══════════ -->
    <section class="py-16 md:py-20 bg-slate-50">
        <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
            <div class="text-center mb-12" data-reveal>
                <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-primary-50 rounded-full text-primary-500 text-xs font-semibold tracking-wide uppercase mb-4">
                    <span class="w-1.5 h-1.5 bg-primary-500 rounded-full"></span>
                    Who We Are
                </div>
                <h2 class="text-2xl md:text-3xl font-bold text-slate-900">About Our Organization</h2>
            </div>
            <div class="space-y-8">
                {% for card in aboutCards %}
                <div class="flex flex-col {% if loop.index0 % 2 == 0 %}md:flex-row{% else %}md:flex-row-reverse{% endif %} gap-6 md:gap-10 items-center bg-white rounded-2xl border border-slate-100 overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300" data-reveal>
                    {% set cardFocusMap = { "center":"object-center", "top":"object-top", "bottom":"object-bottom" } %}
                    <div class="md:w-1/2 aspect-[4/3] md:aspect-auto md:h-72 overflow-hidden flex-shrink-0">
                        <img src="{{ card.image }}" alt="{{ card.alt }}" class="w-full h-full object-cover {{ cardFocusMap[card.imageFocus] or 'object-center' }}" loading="lazy">
                    </div>
                    <div class="md:w-1/2 p-6 sm:p-8 {% if loop.index0 % 2 == 0 %}md:pr-10{% else %}md:pl-10{% endif %}">
                        <h3 class="text-xl font-bold text-slate-800 mb-3">{{ card.title }}</h3>
                        <p class="text-slate-500 text-sm sm:text-base leading-relaxed mb-5">{{ card.description }}</p>
                        <a href="{{ card.link }}" class="inline-flex items-center gap-2 text-primary-500 text-sm font-semibold hover:gap-3 transition-all">
                            Learn more
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                        </a>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- ═══════════ SECTION 6: Trust / Transparency ═══════════ -->
    <section class="py-14 md:py-16 bg-primary-500 relative overflow-hidden">
        <div class="absolute inset-0 opacity-5">
            <svg width="100%" height="100%"><defs><pattern id="trust-grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5"/></pattern></defs><rect width="100%" height="100%" fill="url(#trust-grid)"/></svg>
        </div>
        <div class="max-w-5xl mx-auto px-5 sm:px-8 relative z-10 text-center" data-reveal>
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Your Support Reaches Those Who Need It Most</h2>
            <p class="text-primary-100 text-sm sm:text-base max-w-2xl mx-auto mb-10">We are committed to transparency and accountability in every project we undertake.</p>

            {% if trustPoints and trustPoints | length %}
            <div class="flex flex-wrap justify-center gap-4 sm:gap-6 mb-10">
                {% for point in trustPoints %}
                <div class="flex items-center gap-3 bg-white/10 backdrop-blur-sm border border-white/10 rounded-xl px-5 py-3">
                    <div class="w-10 h-10 rounded-full bg-white/15 flex items-center justify-center flex-shrink-0">
                        <i class="{{ point.icon or 'fa-solid fa-check' }} text-white text-sm"></i>
                    </div>
                    <span class="text-white text-sm font-medium">{{ point.label }}</span>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="flex flex-wrap justify-center gap-4 sm:gap-6 mb-10">
                <div class="flex items-center gap-3 bg-white/10 backdrop-blur-sm border border-white/10 rounded-xl px-5 py-3">
                    <div class="w-10 h-10 rounded-full bg-white/15 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-building-columns text-white text-sm"></i>
                    </div>
                    <span class="text-white text-sm font-medium">Registered Society</span>
                </div>
                <div class="flex items-center gap-3 bg-white/10 backdrop-blur-sm border border-white/10 rounded-xl px-5 py-3">
                    <div class="w-10 h-10 rounded-full bg-white/15 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-receipt text-white text-sm"></i>
                    </div>
                    <span class="text-white text-sm font-medium">80G Tax Exemption</span>
                </div>
                <div class="flex items-center gap-3 bg-white/10 backdrop-blur-sm border border-white/10 rounded-xl px-5 py-3">
                    <div class="w-10 h-10 rounded-full bg-white/15 flex items-center justify-center flex-shrink-0">
                        <i class="fa-solid fa-globe text-white text-sm"></i>
                    </div>
                    <span class="text-white text-sm font-medium">FCRA Certified</span>
                </div>
            </div>
            {% endif %}

            <a href="/support/" class="inline-flex items-center justify-center px-7 py-3 bg-white text-primary-600 rounded-full text-sm font-bold hover:bg-primary-50 transition-colors shadow-lg shadow-primary-900/20">
                <i class="fa-solid fa-hand-holding-heart mr-2"></i>
                Support Us
            </a>
        </div>
    </section>

    <!-- ═══════════ SECTION 7: Location Map ═══════════ -->
    <section class="py-16 md:py-20 bg-white">
        <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
            <div class="text-center mb-10" data-reveal>
                <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-primary-50 rounded-full text-primary-500 text-xs font-semibold tracking-wide uppercase mb-4">
                    <span class="w-1.5 h-1.5 bg-primary-500 rounded-full"></span>
                    Location
                </div>
                <h2 class="text-2xl md:text-3xl font-bold text-slate-900">Find Us</h2>
                <p class="mt-3 text-slate-400 text-sm sm:text-base">{{ site.address }}</p>
            </div>
            <div class="rounded-2xl overflow-hidden border border-slate-100 shadow-sm" data-reveal data-reveal-delay="1">
                <iframe width="100%" height="400" frameborder="0" style="border:0;" src="{{ site.mapEmbedUrl }}" allowfullscreen loading="lazy"></iframe>
            </div>
        </div>
    </section>

    <!-- ═══════════ SECTION 8: Footer ═══════════ -->
    {% include "partials/footer.njk" %}

    <!-- Scripts -->
    <script src="/js/swiper/swiper.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Mobile menu
            var btn = document.getElementById('mobile-menu-btn');
            var overlay = document.getElementById('mobile-overlay');
            var menuPanel = document.getElementById('mobile-menu-panel');
            var closeBtn = document.getElementById('mobile-menu-close');

            function openMenu() {
                overlay.classList.remove('hidden');
                requestAnimationFrame(function() {
                    overlay.classList.add('active');
                    menuPanel.classList.add('translate-x-0');
                    menuPanel.classList.remove('translate-x-full');
                });
                document.body.style.overflow = 'hidden';
            }
            function closeMenu() {
                overlay.classList.remove('active');
                menuPanel.classList.remove('translate-x-0');
                menuPanel.classList.add('translate-x-full');
                document.body.style.overflow = '';
                setTimeout(function() { overlay.classList.add('hidden'); }, 300);
            }

            if (btn) btn.addEventListener('click', openMenu);
            if (closeBtn) closeBtn.addEventListener('click', closeMenu);
            if (overlay) overlay.addEventListener('click', function(e) { if (e.target === overlay) closeMenu(); });

            document.querySelectorAll('.mobile-dropdown-btn').forEach(function(b) {
                b.addEventListener('click', function() {
                    var panel = b.nextElementSibling;
                    var icon = b.querySelector('.dropdown-icon');
                    if (panel) panel.classList.toggle('hidden');
                    if (icon) icon.classList.toggle('rotate-180');
                });
            });

            var autoplayDuration = 30000;
            var progressBar = document.getElementById('hero-progress');
            var currentEl = document.getElementById('hero-current');

            function pad(n) { return n < 10 ? '0' + n : '' + n; }

            function startProgress() {
                if (!progressBar) return;
                progressBar.style.transition = 'none';
                progressBar.style.width = '0%';
                requestAnimationFrame(function() {
                    requestAnimationFrame(function() {
                        progressBar.style.transition = 'width ' + (autoplayDuration / 1000) + 's linear';
                        progressBar.style.width = '100%';
                    });
                });
            }

            var heroSwiper = new Swiper('.gallery-top', {
                navigation: { nextEl: '.hero-carousel .swiper-button-next', prevEl: '.hero-carousel .swiper-button-prev' },
                pagination: { el: '.hero-dots', clickable: true },
                loop: true,
                effect: 'fade',
                fadeEffect: { crossFade: true },
                autoplay: { delay: autoplayDuration, disableOnInteraction: false, pauseOnMouseEnter: true },
                speed: 1200,
                grabCursor: true,
                on: {
                    slideChange: function() {
                        if (currentEl) currentEl.textContent = pad(this.realIndex + 1);
                    },
                    slideChangeTransitionEnd: startProgress
                }
            });

            startProgress();
        });
    </script>

    <script>
    (function() {
        var overlay = document.getElementById('mobile-overlay');
        if (!overlay) return;
        var bg = overlay.querySelector(':scope > div:first-child');
        var origAdd = overlay.classList.add.bind(overlay.classList);
        var origRemove = overlay.classList.remove.bind(overlay.classList);
        Object.defineProperty(overlay.classList, 'add', { value: function(c) { origAdd(c); if (c === 'active' && bg) bg.style.opacity = '1'; } });
        Object.defineProperty(overlay.classList, 'remove', { value: function(c) { origRemove(c); if (c === 'active' && bg) bg.style.opacity = '0'; } });
    })();
    </script>

    <script>
    (function() {
        var els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) { els.forEach(function(e) { e.classList.add('revealed'); }); return; }
        var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('revealed');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        els.forEach(function(el) { observer.observe(el); });
    })();
    </script>
</body>
</html>
