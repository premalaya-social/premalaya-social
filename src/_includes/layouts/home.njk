<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link href="/favicon.ico" type="image/x-icon" rel="icon">
    <link href="/favicon.ico" type="image/x-icon" rel="shortcut icon">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href='https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Roboto:wght@300;400;500;700;900&display=swap' rel='stylesheet'>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/swiper/swiper.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: { 50:'#eef0ff', 100:'#e0e2ff', 200:'#c7caff', 400:'#7b7fff', 500:'#2f3192', 600:'#262a7a', 700:'#1d2062', 800:'#14174a', 900:'#0b0d32' },
                        secondary: { 50:'#edfaff', 100:'#d6f3ff', 400:'#3eb8e6', 500:'#1090bf', 600:'#0d7299' },
                        accent: '#2a2b64'
                    },
                    fontFamily: { 'sans':['Inter','system-ui','sans-serif'], 'roboto':['Roboto','sans-serif'] }
                }
            }
        }
    </script>
    <style>
        .navlogo { background-image:url('/img/images2/premalayalogos.png'); background-size:contain; background-repeat:no-repeat; background-position:center; width:200px; height:50px; }
        @media(min-width:768px) { .navlogo { background-image:url('/img/images2/premalayalogol.png'); width:340px; height:55px; } }
        .swiper-pagination-bullet { width:28px!important; height:3px!important; border-radius:2px!important; background:#fff!important; opacity:.4!important; transition:all .3s!important; }
        .swiper-pagination-bullet-active { opacity:1!important; width:40px!important; }
        .swiper-button-next,.swiper-button-prev { width:40px!important; height:40px!important; background:rgba(255,255,255,.85)!important; border-radius:50%!important; box-shadow:0 2px 8px rgba(0,0,0,.12)!important; transition:all .3s!important; }
        .swiper-button-next:after,.swiper-button-prev:after { font-size:16px!important; color:#2f3192!important; font-weight:bold!important; }
        .swiper-button-next:hover,.swiper-button-prev:hover { background:#fff!important; box-shadow:0 4px 16px rgba(0,0,0,.18)!important; transform:scale(1.08)!important; }
        .swiper-button-next { right:16px!important; }
        .swiper-button-prev { left:16px!important; }
        @media(max-width:640px) { .swiper-button-next,.swiper-button-prev { display:none!important; } }
    </style>
</head>
<body class="font-sans antialiased text-gray-800 bg-white">

    {% include "partials/topbar.njk" %}
    {% include "partials/nav.njk" %}

    <!-- Hero -->
    <section class="relative bg-gray-50">
        <div class="swiper-container gallery-top w-full" style="height:clamp(280px,45vw,560px);">
            <div class="swiper-wrapper">
                {% for slide in heroSlides %}
                <div class="swiper-slide relative">
                    <a href="{{ slide.link }}" class="block w-full h-full">
                        {% set slideFocusMap = { "center": "object-center", "top": "object-top", "bottom": "object-bottom", "left": "object-left", "right": "object-right" } %}
                        <img src="{{ slide.image }}" alt="{{ slide.alt }}" class="w-full h-full object-cover {{ slideFocusMap[slide.imageFocus] or 'object-center' }}"/>
                        <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-black/20 to-transparent"></div>
                        <div class="absolute inset-0 flex items-end pb-16 sm:items-center sm:pb-0">
                            <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-10 w-full">
                                <div class="max-w-md">
                                    <p class="text-white/70 text-xs sm:text-sm font-medium mb-2 tracking-wide">{{ slide.badge }}</p>
                                    <h2 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold text-white leading-snug" style="text-shadow:0 1px 12px rgba(0,0,0,0.3);">{{ slide.heading }}</h2>
                                    <p class="text-white/80 text-sm mt-2 hidden sm:block">{{ slide.subtext }}</p>
                                    <span class="inline-block mt-4 px-4 py-2 bg-white text-primary-600 rounded-lg text-sm font-semibold hover:bg-gray-100 transition-colors">{{ slide.buttonText }}</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                {% endfor %}
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-pagination absolute bottom-6 left-0 right-0 text-center z-10"></div>
        </div>
    </section>

    <!-- Mission -->
    <section class="bg-white py-14 md:py-20">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 leading-snug font-roboto">
                Welcome to <span class="text-primary-500">Premalaya Social</span> Development Society
            </h1>
            <p class="mt-5 text-gray-500 text-base sm:text-lg leading-relaxed max-w-3xl mx-auto">
                Premalaya Social Development Society works for the well-being of downtrodden and vulnerable sections
                in <strong class="text-gray-700">Tiruvallur, Chennai Districts of Tamilnadu</strong> and in
                <strong class="text-gray-700">Prakasam, Nellore Districts of Andhra Pradesh.</strong>
                We work for the community through education, health, advocacy, communication and social mobilization.
            </p>
            <div class="flex flex-col sm:flex-row gap-3 justify-center mt-8">
                <a href="/about/" class="inline-flex items-center justify-center px-5 py-2.5 bg-primary-500 text-white rounded-lg text-sm font-semibold hover:bg-primary-600 transition-colors">
                    Learn More
                    <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </a>
                <a href="/pdf/savithribaischolarship.pdf" class="inline-flex items-center justify-center px-5 py-2.5 border border-gray-200 text-gray-600 rounded-lg text-sm font-semibold hover:border-gray-300 hover:bg-gray-50 transition-all">
                    <i class="fa-solid fa-download mr-2 text-xs"></i>
                    Scholarship Form
                </a>
            </div>
        </div>
    </section>

    <!-- Stats -->
    <section class="border-y border-gray-100">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
                <div>
                    <div class="w-10 h-10 rounded-lg bg-primary-50 flex items-center justify-center mx-auto mb-3">
                        <i class="fa-solid fa-users text-primary-500"></i>
                    </div>
                    <h3 class="text-sm font-bold text-gray-900">Community Focus</h3>
                    <p class="text-xs text-gray-400 mt-1">Serving vulnerable sections across Tamil Nadu & AP</p>
                </div>
                <div>
                    <div class="w-10 h-10 rounded-lg bg-secondary-50 flex items-center justify-center mx-auto mb-3">
                        <i class="fa-solid fa-book-open text-secondary-500"></i>
                    </div>
                    <h3 class="text-sm font-bold text-gray-900">Education First</h3>
                    <p class="text-xs text-gray-400 mt-1">Scholarships and skill development programs</p>
                </div>
                <div>
                    <div class="w-10 h-10 rounded-lg bg-green-50 flex items-center justify-center mx-auto mb-3">
                        <i class="fa-solid fa-heart-pulse text-green-500"></i>
                    </div>
                    <h3 class="text-sm font-bold text-gray-900">Healthcare Access</h3>
                    <p class="text-xs text-gray-400 mt-1">Medical camps for underserved communities</p>
                </div>
            </div>
        </div>
    </section>

    <!-- About -->
    <section class="bg-gray-50 py-16 md:py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-10">
                <p class="text-xs font-semibold text-primary-500 uppercase tracking-widest mb-2">Who We Are</p>
                <h2 class="text-2xl md:text-3xl font-bold text-gray-900 font-roboto">About Our Organization</h2>
            </div>
            <div class="grid md:grid-cols-3 gap-6">
                {% for card in aboutCards %}
                {% set cardFocusMap = { "center": "object-center", "top": "object-top", "bottom": "object-bottom" } %}
                <a href="{{ card.link }}" class="group bg-white rounded-xl overflow-hidden border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all">
                    <div class="aspect-[4/3] overflow-hidden">
                        <img src="{{ card.image }}" alt="{{ card.alt }}" class="w-full h-full object-cover {{ cardFocusMap[card.imageFocus] or 'object-center' }} group-hover:scale-105 transition-transform duration-500"/>
                    </div>
                    <div class="p-5">
                        <h3 class="font-bold text-gray-900 mb-1 group-hover:text-primary-500 transition-colors">{{ card.title }}</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">{{ card.description }}</p>
                    </div>
                </a>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Programs -->
    <section class="bg-white py-16 md:py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-10">
                <p class="text-xs font-semibold text-primary-500 uppercase tracking-widest mb-2">What We Do</p>
                <h2 class="text-2xl md:text-3xl font-bold text-gray-900 font-roboto">Our Programs</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for card in projectCards %}
                {% set projFocusMap = { "center": "object-center", "top": "object-top", "bottom": "object-bottom" } %}
                <a href="{{ card.link }}" class="group bg-white rounded-xl overflow-hidden border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all">
                    <div class="aspect-[4/3] overflow-hidden">
                        <img src="{{ card.image }}" alt="{{ card.alt }}" class="w-full h-full object-cover {{ projFocusMap[card.imageFocus] or 'object-center' }} group-hover:scale-105 transition-transform duration-500"/>
                    </div>
                    <div class="p-5">
                        <h3 class="font-bold text-gray-900 mb-1 group-hover:text-primary-500 transition-colors">{{ card.title }}</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">{{ card.description }}</p>
                    </div>
                </a>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="bg-primary-500 py-10">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-xl md:text-2xl font-bold text-white font-roboto">Support Our Mission</h2>
            <p class="text-primary-200 mt-2 text-sm">Your support can make a significant difference in the lives of those we serve.</p>
            <div class="flex flex-col sm:flex-row gap-3 justify-center mt-6">
                <a href="/support/" class="inline-flex items-center justify-center px-5 py-2.5 bg-white text-primary-600 rounded-lg text-sm font-semibold hover:bg-gray-100 transition-colors">Support Us</a>
                <a href="/contact/" class="inline-flex items-center justify-center px-5 py-2.5 border border-white/30 text-white rounded-lg text-sm font-semibold hover:bg-white/10 transition-colors">Contact Us</a>
            </div>
        </div>
    </section>

    <!-- Map -->
    <section class="bg-gray-50 py-14">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-8">
                <h2 class="text-2xl md:text-3xl font-bold text-gray-900 font-roboto">Find Us</h2>
            </div>
            <div class="rounded-xl overflow-hidden border border-gray-200">
                <iframe width="100%" height="380" frameborder="0" style="border:0" src="{{ site.mapEmbedUrl }}" allowfullscreen loading="lazy"></iframe>
            </div>
        </div>
    </section>

    {% include "partials/footer.njk" %}

    <!-- Scripts -->
    <script src="/js/swiper/swiper.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var btn = document.getElementById('mobile-menu-btn');
            var menu = document.getElementById('mobile-menu');
            var iconOpen = document.getElementById('menu-icon-open');
            var iconClose = document.getElementById('menu-icon-close');
            if (btn && menu) {
                btn.addEventListener('click', function() {
                    menu.classList.toggle('hidden');
                    if (iconOpen && iconClose) { iconOpen.classList.toggle('hidden'); iconClose.classList.toggle('hidden'); }
                });
            }

            document.querySelectorAll('.mobile-dropdown-btn').forEach(function(b) {
                b.addEventListener('click', function() {
                    var panel = b.nextElementSibling;
                    var icon = b.querySelector('.dropdown-icon');
                    if (panel) panel.classList.toggle('hidden');
                    if (icon) icon.classList.toggle('rotate-180');
                });
            });

            new Swiper('.gallery-top', {
                navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
                pagination: { el: '.swiper-pagination', clickable: true },
                loop: true,
                effect: 'fade',
                fadeEffect: { crossFade: true },
                autoplay: { delay: 20000, disableOnInteraction: false, pauseOnMouseEnter: true },
                speed: 1800,
                grabCursor: true
            });
        });
    </script>
</body>
</html>
